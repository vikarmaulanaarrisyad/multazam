generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  DEVELOPER
}

enum VisitStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReturnType {
  EXCHANGE
  REFUND
}

enum ReturnCondition {
  GOOD
  BAD
}

enum TargetPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model SalesTarget {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetAmount Decimal      @db.Decimal(18, 2)
  periodType   TargetPeriod
  startDate    DateTime     
  endDate      DateTime     
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, startDate, endDate])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(SALES)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  transactions     Transaction[]
  purchases        Purchase[]
  stockMovements   StockMovement[]
  paymentHistories PaymentHistory[]
  stores           Store[]
  visits           Visit[]
  returns          ReturnTransaction[]
  auditLogs        AuditLog[]
  salesTargets     SalesTarget[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Inventory Models
model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  description     String?
  price           Decimal  @db.Decimal(18, 2)
  purchasePrice   Decimal? @db.Decimal(18, 2)
  contents        String? // for 'ISI' e.g. 48btl
  retailPriceNote String? // for 'BTL,RTG,PCS,BAG'

  // New Product Master Fields
  brand           String?
  status          String  @default("ACTIVE")
  purchaseUnit    String?
  stockBaseUnit   String?
  conversionQty   Int?
  salesMode       String?
  allowUnitSale   Boolean @default(true)
  allowFractional Boolean @default(false)
  legacyCode      String?
  retailEndDate   DateTime?

  stock      Int      @default(0)
  badStock   Int      @default(0)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  unitId     String?
  unit       Unit?    @relation(fields: [unitId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  unitConversions  UnitConversion[]
  transactionItems TransactionItem[]
  stockMovements   StockMovement[]
  purchaseItems    PurchaseItem[]
  returnItems      ReturnItem[]

  @@index([categoryId])
  @@index([unitId])
}

model Transaction {
  id               String    @id @default(cuid())
  invoiceNumber    String    @unique
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  totalAmount      Decimal   @db.Decimal(18, 2)
  status           String    @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  customerName     String?
  customerPhone    String?
  shippingAddress  String?   @db.Text
  shippingCost     Decimal?  @db.Decimal(18, 2)
  dueDate          DateTime?
  deliveryDate     DateTime?
  notes            String?   @db.Text
  adminNotes       String?   @db.Text
  latitude         Float?
  longitude        Float?
  paidAmount       Decimal   @default(0) @db.Decimal(18, 2)
  paymentStatus    String    @default("UNPAID") // UNPAID, PARTIAL, PAID
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  hasBeenReordered Boolean   @default(false)

  items            TransactionItem[]
  paymentHistories PaymentHistory[]
  returns          ReturnTransaction[]

  @@index([createdAt])
  @@index([status])
  @@index([userId, createdAt])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  price         Decimal     @db.Decimal(18, 2)
  originalPrice Decimal?    @db.Decimal(18, 2)
  purchasePrice Decimal?    @db.Decimal(18, 2)
  unitNote      String?

  @@index([transactionId])
  @@index([productId])
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Int
  balanceBefore Int
  balanceAfter  Int
  reference     String?
  notes         String?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([productId])
}

model PaymentHistory {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(18, 2)
  paymentMethod String      @default("CASH") // CASH, TRANSFER, dll
  notes         String?     @db.Text
  userId        String // Siapa yang mencatat pembayaran ini
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  email     String?
  phone     String?
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
}

model Purchase {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  totalAmount   Decimal  @db.Decimal(18, 2)
  status        String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items PurchaseItem[]

  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  price      Decimal  @db.Decimal(18, 2)

  @@index([purchaseId])
  @@index([productId])
}

model Setting {
  id             String   @id @default("1")
  companyName    String   @default("DIA MAKMUR ABADI")
  companyAddress String   @default("Jl. Contoh Alamat No. 123, Kota, Provinsi")
  logoUrl        String?
  logoPublicId   String?
  officeLat      Float?
  officeLng      Float?
  
  // Developer & Trial Settings
  trialActive           Boolean   @default(false)
  trialExpiresAt        DateTime?
  showDeveloperModal    Boolean   @default(false)
  developerModalTitle   String?
  developerModalContent String?   @db.Text

  updatedAt      DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  status    String   @default("UNREAD") // UNREAD, READ
  role      String   @default("ADMIN")
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  ownerName String
  address   String   @db.Text
  phone     String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]
}

model Visit {
  id          String      @id @default(cuid())
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  scheduledAt DateTime
  address     String      @db.Text
  status      VisitStatus @default(SCHEDULED)
  notes       String?     @db.Text

  // Geofencing data
  actualLat   Float?
  actualLng   Float?
  checkInTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scheduledAt])
  @@index([storeId])
}

model InvoiceCounter {
  id      Int    @id @default(autoincrement())
  date    String @unique
  counter Int    @default(1)
}

model ReturnTransaction {
  id            String       @id @default(cuid())
  returnNumber  String       @unique
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  customerName  String
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  status        ReturnStatus @default(PENDING)
  type          ReturnType
  notes         String?      @db.Text
  adminNotes    String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items ReturnItem[]
}

model ReturnItem {
  id                  String            @id @default(cuid())
  returnTransactionId String
  returnTransaction   ReturnTransaction @relation(fields: [returnTransactionId], references: [id], onDelete: Cascade)
  productId           String
  product             Product           @relation(fields: [productId], references: [id])
  quantity            Int
  condition           ReturnCondition
  price               Decimal           @db.Decimal(18, 2)
  unitNote            String?
  totalPrice          Decimal?          @db.Decimal(18, 2)

  @@index([returnTransactionId])
}

model UnitConversion {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  fromUnit       String
  toUnit         String
  conversionQty  Int
  conversionType String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, fromUnit, toUnit])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String   // CREATE, UPDATE, DELETE, LOGIN, dll
  entityType String   // PRODUCT, TRANSACTION, USER, dll
  entityId   String   // ID produk / transaksi yg diubah
  details    String   @db.Text
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
